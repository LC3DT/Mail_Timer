# ============================================================
# 邮件定时发送程序 — 配置文件模板
# 使用说明：
#   1. 复制此文件并重命名为 .env
#   2. 填写下方所有配置项
#   3. .env 文件不会被 Git 追踪（已在 .gitignore 中忽略）
# ============================================================

# ---------- SMTP 服务器配置 ----------
# Bossmail（老板邮局）：smtp.laobanmail.com，端口 465（SSL）
#   → 企业自有域名也可能是 smtp.<你的域名>.com
#   → 不确定时可在 https://www.laobanmail.com/help?type=62 查询
# QQ邮箱：smtp.qq.com，端口 587 或 465
# 163邮箱：smtp.163.com，端口 587 或 465
# Gmail：smtp.gmail.com，端口 587 或 465
SMTP_SERVER=smtp.laobanmail.com
SMTP_PORT=465
SMTP_USE_TLS=False

# ---------- 发件人信息 ----------
# 邮箱地址（需填写完整地址，包含 @ 后面部分）
SENDER_EMAIL=your_name@your_domain.com
# 邮箱密码（即登录网页版邮箱使用的密码）
SENDER_PASSWORD=your_email_password_here

# ---------- 收件人 ----------
# 多个收件人用英文逗号分隔
RECIPIENTS=receiver1@example.com,receiver2@example.com

# ---------- 抄送（CC）----------
# 多个抄送人用英文逗号分隔，不需要请留空
CC=cc_person@example.com

# ---------- 邮件内容 ----------
SUBJECT=这是一封定时发送的测试邮件
# 纯文本正文（与 HTML 至少提供一个）
BODY_TEXT=你好！这是一封由 Python 定时发送程序自动发送的测试邮件。
# HTML 正文（可选，同时提供时邮件客户端优先显示 HTML 版本）
BODY_HTML=<html><body><h2>你好！</h2><p>这是一封由 <b>Python 定时发送程序</b> 自动发送的测试邮件。</p></body></html>

# ---------- 附件 ----------
# 多个附件用英文逗号分隔，不需要请留空
ATTACHMENTS=

# ============================================================
# 调度模式配置（二选一）
# ============================================================

# 调度类型：once = 单次定时 | cron = 周期定时
SCHEDULE_TYPE=once

# ---- 单次模式（SCHEDULE_TYPE=once 时生效）----
# 格式：YYYY-MM-DD HH:MM:SS（24小时制）
SCHEDULE_TIME=2026-12-31 09:00:00

# ---- 周期模式（SCHEDULE_TYPE=cron 时生效）----
# Cron 表达式格式：分 时 日 月 周
# 示例：
#   0 9 25 * *     → 每月25号上午9点
#   30 8 * * 1-5   → 工作日（周一至周五）上午8:30
#   0 9 * * *      → 每天上午9点
#   0 9 1 * *      → 每月1号上午9点
# SCHEDULE_CRON=0 9 25 * *

# ---------- 日志文件（可选）----------
# 日志文件路径，留空则不写入文件（推荐，降低磁盘 I/O）
LOG_FILE=
